# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # 서버 전용 (cron 정리·관리 스크립트)

# ── 앱 ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # 공유 링크 베이스 URL
NEXT_PUBLIC_DB_ENV=dev                      # (선택) dev | prod — 개발자 도구 페이지 DB 표시용

# ── AI / OCR ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
VOCAB_GRADING_MODEL=                # (선택) 단어 채점 모델 override
CLOVA_OCR_API_URL=
CLOVA_OCR_SECRET=
GOOGLE_CLOUD_VISION_API_KEY=        # (선택) /dev OCR 비교 도구 전용

# ── 문자 발송 (Solapi) ────────────────────────────────────
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=                      # 발신번호

# ── Cron (Vercel Cron → /api/cron/cleanup) ────────────────
CRON_SECRET=
VOCAB_PHOTO_RETENTION_DAYS=30       # (선택) 단어 시험지 사진 보관 일수

# ── 외부 기출 통계 연동 (선택 — 미설정 시 기능 비활성) ────
EXAM_STATS_BASE_URL=                # 통계 사이트 베이스 URL
EXAM_STATS_LIST_PATH=               # 시험 목록 조회 경로 (BASE 기준 상대경로)
EXAM_STATS_RATE_PATH=               # 문항별 통계 경로 (BASE 기준 상대경로)
EXAM_STATS_REFERER=                 # (선택) Referer 헤더
