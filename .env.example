# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # 서버 전용 (cron 정리·관리 스크립트)
DATABASE_URL=                       # 서버 전용: edunote_app.<project-ref> 계정의 transaction pooler(6543) URL
DATABASE_CA_CERT=                   # (필요시) DB CA 인증서 PEM. TLS 검증은 끄지 않음

# ── 앱 ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000   # 공유 링크 베이스 URL
NEXT_PUBLIC_DB_ENV=dev                      # (선택) dev | prod — 개발자 도구 페이지 DB 표시용

# ── AI / OCR ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLOVA_OCR_API_URL=
CLOVA_OCR_SECRET=
GOOGLE_CLOUD_VISION_API_KEY=        # (선택) /dev OCR 비교 도구 전용

# ── 문자 발송 (Solapi) ────────────────────────────────────
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=                      # 발신번호

# ── Cron (Vercel Cron → /api/cron/rotate-share-tokens) ────
CRON_SECRET=

# ── PDF worker (DB migration + Cloud Run Jobs 설정 후 활성화) ──
PDF_IMPORT_WORKER_ENABLED=false
BOOK_PDF_IMPORT_ENABLED=false     # 교재 자동 검증 SQL 적용 + 새 워커/웹 배포 확인 후 활성화
GCP_PROJECT_ID=
GCP_WORKER_REGION=asia-northeast3
GCP_BANK_PDF_JOB=edunote-bank-pdf
GCP_WEEK_PDF_JOB=edunote-week-pdf
GCP_WORKLOAD_IDENTITY_AUDIENCE=     # //iam.googleapis.com/projects/프로젝트번호/locations/global/workloadIdentityPools/풀/providers/공급자
GCP_WORKER_SERVICE_ACCOUNT_EMAIL=  # dispatcher 서비스 계정 이메일 (키 없이 Vercel OIDC 인증)
GCP_WORKER_SERVICE_ACCOUNT_JSON=    # (선택) 기존 JSON 인증 호환용. OIDC 두 값 설정 시 사용하지 않음
# 아래 값은 Cloud Run 컨테이너 또는 .env.worker에 설정
PDF_WORKER_CONCURRENCY=8           # 1~32. 실제 운영 Job의 기존 값은 별도로 변경
PDF_IMPORT_JOB_ID=                 # 실행별 override. Job 기본값으로 고정하지 않음
